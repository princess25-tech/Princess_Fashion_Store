<main id="main-content" class="form-page"><section class="content-section"><div class="section-heading"><p class="section-label">GET IN TOUCH</p><h1>Contact Us</h1><p class="section-description">Send us a general message, feedback or question. Fields marked required must be completed.</p></div><form class="contact-form validated-form" id="contact-form" data-form-type="contact" novalidate><div class="form-group"><label for="contact-name">Full name *</label><input id="contact-name" name="name" type="text" minlength="2" maxlength="80" autocomplete="name" required><small class="field-error"></small></div><div class="form-group"><label for="contact-email">Email address *</label><input id="contact-email" name="email" type="email" autocomplete="email" required><small class="field-error"></small></div><div class="form-group"><label for="contact-phone">Phone number (optional)</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" pattern="[+0-9() -]{7,20}" placeholder="e.g. +27 68 515 0471"><small class="field-error"></small></div><div class="form-group"><label for="contact-type">Message type *</label><select id="contact-type" name="messageType" required><option value="">Choose a message type</option><option>General question</option><option>Feedback</option><option>Complaint</option><option>Compliment</option><option>Other</option></select><small class="field-error"></small></div><div class="form-group"><label for="contact-message">Your message *</label><textarea id="contact-message" name="message" rows="6" minlength="10" maxlength="1500" required placeholder="How can we help?"></textarea><small class="field-error"></small></div><button type="submit">Prepare Email</button><p class="form-note">This static website prepares an email in your device's default email app. It does not send or store your message automatically.</p><p class="form-feedback" id="contact-feedback" role="status" aria-live="polite"></p></form><div class="contact-details"><h2>Store details</h2><p>Email: <a href="mailto:info@princessfashionstore.com">info@princessfashionstore.com</a></p><p>Phone: <a href="tel:+27685150471">(+27) 68 515 0471</a></p><p>Address: 192 Suid Street, Polokwane</p><div class="map-embed"><iframe title="Map search for 192 Suid Street, Polokwane" src="https://www.google.com/maps?q=192%20Suid%20Street%2C%20Polokwane&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></div></section></main><footer class="site-footer"><div class="footer-container"><div><h2>Princess Fashion Store</h2><p>Your One-Stop Shop for All Things Fashion.</p></div><div class="footer-links"><a href="index.html">Home</a><a href="index.html#clothing">Clothing</a><a href="enquiry.html">Enquiries</a><a href="contact.html">Contact</a></div></div><div class="copyright"><p>&copy; 2026 Princess Fashion Store. All rights reserved.</p></div></footer><div class="toast" id="site-toast" role="status" aria-live="polite"></div></body></html>
