/* =====================================================
   PRINCESS FASHION STORE
   Main Stylesheet
   ===================================================== */


/* =====================================================
   1. RESET / BASE STYLES
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
}


body {
    font-family: Arial, Helvetica, sans-serif;

    font-size: 1rem;

    line-height: 1.6;

    background-color: #fff;

    color: #222;

    overflow-x: hidden;
}


img {
    max-width: 100%;
    height: auto;
    display: block;
}


a {
    color: inherit;
}


button,
input,
textarea {
    font: inherit;
}


/* =====================================================
   2. ACCESSIBILITY
   ===================================================== */

.skip-link {
    position: absolute;

    left: -9999px;

    top: 1rem;

    background: #000;

    color: #fff;

    padding: 0.75rem 1rem;

    z-index: 9999;
}


.skip-link:focus {
    left: 1rem;
}


/* =====================================================
   3. HEADER
   ===================================================== */

.site-header {
    background-color: #ffffff;

    border-bottom: 1px solid #eeeeee;

    position: sticky;

    top: 0;

    z-index: 1000;
}


.header-container {
    width: min(92%, 75rem);

    margin: 0 auto;

    min-height: 5rem;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 2rem;
}


.brand {
    display: flex;

    align-items: center;

    gap: 0.8rem;
}


.brand-logo {
    width: 3rem;

    height: 3rem;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background-color: #111;

    color: #fff;

    font-size: 1.5rem;

    font-weight: 700;
}


.brand h1 {
    font-size: 1.25rem;

    line-height: 1.2;
}


.brand p {
    font-size: 0.8rem;

    color: #777;
}


/* =====================================================
   4. NAVIGATION
   ===================================================== */

.main-navigation ul {
    list-style: none;

    display: flex;

    align-items: center;

    gap: 1.5rem;
}


.main-navigation a {
    text-decoration: none;

    font-size: 0.9rem;

    font-weight: 600;

    color: #333;

    transition: 0.3s ease;
}


.main-navigation a:hover,
.main-navigation a:focus {
    color: #777;
}


/* =====================================================
   5. HERO SECTION
   ===================================================== */

.hero {
    min-height: 75vh;

    display: grid;

    place-items: center;

    text-align: center;

    padding: 5rem 1.5rem;

    background:
        linear-gradient(
            135deg,
            #f5f5f5,
            #ffffff
        );
}


.hero-content {
    width: min(100%, 55rem);

    margin: 0 auto;
}


.eyebrow,
.section-label {
    font-size: 0.75rem;

    font-weight: 700;

    letter-spacing: 0.2em;

    text-transform: uppercase;

    color: #777;

    margin-bottom: 1rem;
}


.hero h2 {
    font-size: clamp(2.5rem, 7vw, 5.5rem);

    line-height: 0.95;

    letter-spacing: -0.05em;

    margin-bottom: 1.5rem;
}


.hero h2 span {
    display: block;

    font-weight: 300;
}


.hero-content > p:not(.eyebrow) {
    max-width: 40rem;

    margin: 0 auto 2rem;

    color: #555;

    font-size: clamp(1rem, 2vw, 1.2rem);
}


.hero-button {
    display: inline-block;

    padding: 0.9rem 1.5rem;

    background-color: #111;

    color: #fff;

    text-decoration: none;

    font-weight: 700;

    border: 2px solid #111;

    transition: 0.3s ease;
}


.hero-button:hover,
.hero-button:focus {
    background-color: transparent;

    color: #111;
}


/* =====================================================
   6. GENERAL SECTIONS
   ===================================================== */

.content-section {
    width: min(92%, 75rem);

    margin: 0 auto;

    padding: 6rem 0;
}


.section-light {
    width: 100%;

    max-width: none;

    padding-left: max(4%, calc((100% - 69rem) / 2));

    padding-right: max(4%, calc((100% - 69rem) / 2));

    background-color: #f7f7f7;
}


.section-heading {
    margin-bottom: 2rem;
}


.section-heading h2,
.contact-information h2,
.social-section h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);

    line-height: 1;

    letter-spacing: -0.03em;

    margin-bottom: 1rem;
}


.section-description {
    max-width: 48rem;

    color: #555;

    font-size: 1.05rem;
}


/* =====================================================
   7. ABOUT SECTION
   ===================================================== */

.about-content {
    display: grid;

    grid-template-columns:
        minmax(0, 2fr)
        minmax(15rem, 1fr);

    gap: 3rem;

    align-items: start;
}


.about-text {
    font-size: 1.1rem;

    color: #444;
}


.about-text p + p {
    margin-top: 1.2rem;
}


.about-highlight {
    padding: 2rem;

    border: 1px solid #ddd;

    background-color: #fafafa;
}


.about-highlight strong {
    display: block;

    font-size: 1.25rem;

    margin-bottom: 0.75rem;
}


.about-highlight p {
    color: #666;
}


/* =====================================================
   8. VALUES
   ===================================================== */

.values-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 1.5rem;
}


.value-card {
    padding: 2rem;

    background-color: #fff;

    border: 1px solid #e5e5e5;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}


.value-card:hover {
    transform: translateY(-0.4rem);

    box-shadow:
        0 1rem 2rem rgba(0, 0, 0, 0.08);
}


.value-icon {
    margin-bottom: 2rem;

    font-size: 0.8rem;

    font-weight: 700;

    color: #777;
}


.value-card h3 {
    margin-bottom: 0.75rem;

    font-size: 1.4rem;
}


.value-card p {
    color: #666;
}


/* =====================================================
   9. CLOTHING CARDS
   ===================================================== */

.clothing-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 1rem;
}


.clothing-card {
    min-height: 18rem;

    padding: 2rem;

    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    background-color: #111;

    color: #fff;

    transition:
        transform 0.3s ease;
}


.clothing-card:hover {
    transform: translateY(-0.4rem);
}


.clothing-number {
    margin-bottom: auto;

    font-size: 0.75rem;

    color: #aaa;

    font-weight: 700;
}


.clothing-card h3 {
    font-size: 1.4rem;

    margin-bottom: 0.75rem;
}


.clothing-card p {
    color: #ccc;

    font-size: 0.9rem;
}


/* =====================================================
   10. CONTACT SECTION
   ===================================================== */

.contact-section {
    padding: 6rem 4%;

    background-color: #eeeeee;
}


.contact-container {
    width: min(100%, 75rem);

    margin: 0 auto;

    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 4rem;
}


.contact-information > p:not(.section-label) {
    max-width: 35rem;

    color: #555;

    margin-bottom: 2rem;
}


.contact-item {
    margin-bottom: 1.5rem;
}


.contact-item strong {
    display: block;

    margin-bottom: 0.25rem;
}


.contact-item a {
    text-decoration: none;

    color: #555;
}


.contact-item a:hover {
    text-decoration: underline;
}


.contact-item address {
    font-style: normal;

    color: #555;
}


/* =====================================================
   11. CONTACT FORM
   ===================================================== */

.contact-form {
    padding: 2rem;

    background-color: #fff;

    border: 1px solid #ddd;
}


.contact-form h3 {
    font-size: 1.5rem;

    margin-bottom: 1.5rem;
}


.form-group {
    margin-bottom: 1rem;
}


.form-group label {
    display: block;

    margin-bottom: 0.4rem;

    font-size: 0.9rem;

    font-weight: 700;
}


.form-group input,
.form-group textarea {
    width: 100%;

    padding: 0.8rem;

    border: 1px solid #ccc;

    background-color: #fff;

    color: #222;

    outline: none;
}


.form-group input:focus,
.form-group textarea:focus {
    border-color: #111;

    box-shadow:
        0 0 0 2px rgba(0, 0, 0, 0.08);
}


.form-group textarea {
    resize: vertical;
}


.contact-form button {
    width: 100%;

    padding: 0.9rem;

    border: 2px solid #111;

    background-color: #111;

    color: #fff;

    font-weight: 700;

    cursor: pointer;

    transition: 0.3s ease;
}


.contact-form button:hover,
.contact-form button:focus {
    background-color: #fff;

    color: #111;
}


/* =====================================================
   12. SOCIAL MEDIA
   ===================================================== */

.social-section {
    width: min(92%, 75rem);

    margin: 0 auto;

    padding: 6rem 0;

    text-align: center;
}


.social-section .section-description {
    margin: 0 auto 2rem;
}


.social-links {
    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 1rem;
}


.social-links a {
    min-width: 8rem;

    padding: 0.75rem 1rem;

    border: 1px solid #ccc;

    text-decoration: none;

    font-weight: 700;

    transition: 0.3s ease;
}


.social-links a:hover,
.social-links a:focus {
    background-color: #111;

    color: #fff;

    border-color: #111;
}


/* =====================================================
   13. FOOTER
   ===================================================== */

.site-footer {
    background-color: #111;

    color: #fff;

    padding: 3rem 4% 1rem;
}


.footer-container {
    width: min(100%, 75rem);

    margin: 0 auto;

    display: flex;

    justify-content: space-between;

    gap: 2rem;
}


.footer-container h2 {
    font-size: 1.3rem;

    margin-bottom: 0.5rem;
}


.footer-container p {
    color: #aaa;
}


.footer-links {
    display: flex;

    gap: 1.5rem;

    align-items: center;
}


.footer-links a {
    color: #fff;

    text-decoration: none;
}


.footer-links a:hover {
    text-decoration: underline;
}


.copyright {
    width: min(100%, 75rem);

    margin: 2rem auto 0;

    padding-top: 1rem;

    border-top: 1px solid #333;

    font-size: 0.8rem;

    color: #888;
}


/* =====================================================
   14. TABLET BREAKPOINT
   ===================================================== */

@media (max-width: 900px) {

    .header-container {
        flex-direction: column;

        padding: 1rem 0;
    }


    .main-navigation ul {
        flex-wrap: wrap;

        justify-content: center;

        gap: 0.75rem 1rem;
    }


    .about-content {
        grid-template-columns: 1fr;
    }


    .values-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .clothing-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .contact-container {
        grid-template-columns: 1fr;

        gap: 3rem;
    }


    .footer-container {
        flex-direction: column;
    }

}


/* =====================================================
   15. MOBILE BREAKPOINT
   ===================================================== */

@media (max-width: 600px) {

    html {
        scroll-padding-top: 1rem;
    }


    .header-container {
        align-items: flex-start;
    }


    .brand h1 {
        font-size: 1.05rem;
    }


    .brand p {
        font-size: 0.7rem;
    }


    .main-navigation {
        width: 100%;
    }


    .main-navigation ul {
        justify-content: flex-start;
    }


    .main-navigation a {
        font-size: 0.8rem;
    }


    .hero {
        min-height: 65vh;

        padding: 4rem 1rem;
    }


    .content-section,
    .social-section {
        padding-top: 4rem;

        padding-bottom: 4rem;
    }


    .section-light {
        padding-left: 4%;

        padding-right: 4%;
    }


    .values-grid,
    .clothing-grid {
        grid-template-columns: 1fr;
    }


    .clothing-card {
        min-height: 15rem;
    }


    .contact-section {
        padding-top: 4rem;

        padding-bottom: 4rem;
    }


    .contact-form {
        padding: 1.25rem;
    }


    .footer-links {
        flex-wrap: wrap;
    }

}


/* =====================================================
   16. REDUCED MOTION ACCESSIBILITY
   ===================================================== */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }


    *,
    *::before,
    *::after {
        transition: none !important;
    }

}
/* Part 3 additions: search controls, dedicated forms, map and feedback. */
.product-tools { display:flex; flex-wrap:wrap; align-items:center; gap:.7rem; margin:1.5rem 0 2rem; padding:1rem; background:#f7f5f8; border-radius:12px; }
.product-tools label { font-weight:700; }
.product-tools input, .product-tools select { min-width:180px; max-width:100%; padding:.75rem; border:1px solid #c9c3cc; border-radius:7px; font:inherit; background:#fff; }
#search-status { flex-basis:100%; margin:0; font-size:.9rem; }
.clothing-card[hidden] { display:none !important; }
.clothing-card[role="button"] { cursor:pointer; }
.clothing-card[role="button"]:focus-visible, a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline:3px solid #b58a35; outline-offset:3px; }
.brand-title { margin:0; font-size:1.4rem; font-weight:800; }
.form-page .content-section { max-width:1000px; margin:0 auto; }
.form-page .section-heading { text-align:center; margin-bottom:2rem; }
.form-page .contact-form { max-width:760px; margin:0 auto; }
.form-group { margin-bottom:1.15rem; }
.form-group label { display:block; font-weight:700; margin-bottom:.45rem; }
.form-group input, .form-group textarea, .form-group select { width:100%; box-sizing:border-box; padding:.8rem .9rem; border:1px solid #c9c3cc; border-radius:7px; font:inherit; background:#fff; }
.form-group input[aria-invalid="true"], .form-group textarea[aria-invalid="true"], .form-group select[aria-invalid="true"] { border-color:#b42318; }
.field-error { display:block; min-height:1.1em; color:#b42318; margin-top:.25rem; }
.form-note { font-size:.9rem; line-height:1.5; color:#5f5964; }
.form-feedback { margin-top:1rem; font-weight:700; }
.enquiry-result { margin-top:1.5rem; padding:1rem 1.2rem; background:#f7f5f8; border-left:4px solid #b58a35; border-radius:6px; }
.contact-details { max-width:760px; margin:2.5rem auto 0; }
.map-embed { margin-top:1rem; overflow:hidden; border-radius:12px; }
.map-embed iframe { width:100%; min-height:300px; border:0; }
.toast { position:fixed; z-index:1000; left:50%; bottom:1.5rem; transform:translate(-50%, 1rem); width:min(90%, 500px); padding:1rem 1.25rem; border-radius:10px; color:#fff; background:#29222d; box-shadow:0 8px 28px #0003; opacity:0; pointer-events:none; transition:opacity .2s ease, transform .2s ease; }
.toast.is-visible { opacity:1; transform:translate(-50%, 0); }
.reveal-on-scroll { opacity:.01; transform:translateY(12px); transition:opacity .5s ease, transform .5s ease; }
.reveal-on-scroll.is-revealed { opacity:1; transform:none; }
@media (max-width:600px) { .product-tools { align-items:stretch; flex-direction:column; } .product-tools input, .product-tools select { width:100%; } .form-page .content-section { padding-left:1rem; padding-right:1rem; } }
@media (prefers-reduced-motion:reduce) { .reveal-on-scroll, .toast { transition:none; } .reveal-on-scroll { opacity:1; transform:none; } }
